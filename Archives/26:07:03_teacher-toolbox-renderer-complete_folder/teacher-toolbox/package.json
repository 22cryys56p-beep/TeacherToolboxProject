{
  "name": "teacher-toolbox",
  "version": "0.1.0",
  "private": true,
  "description": "Teacher Toolbox — Modular educational productivity platform",
  "scripts": {
    "dev": "pnpm --filter @teacher-toolbox/shell dev",
    "build": "pnpm --filter '@teacher-toolbox/*' --recursive build",
    "build:packages": "pnpm --filter './packages/**' --recursive build",
    "typecheck": "pnpm --recursive typecheck",
    "test": "pnpm --recursive test",
    "lint": "pnpm --recursive lint",
    "clean": "pnpm --recursive exec rm -rf dist .svelte-kit"
  },
  "devDependencies": {},
  "workspaces": [
    "packages/*",
    "packages/services/*",
    "apps/*",
    "tools/*"
  ]
}